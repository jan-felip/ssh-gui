#!/usr/bin/env bash
# Launcher: resolve symlink and run ssh_gui.py with the project venv
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  LINK="$(readlink "$SOURCE")"
  if [[ "$LINK" == /* ]]; then
    SOURCE="$LINK"
  else
    SOURCE="$DIR/$LINK"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

PY="$ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "Missing venv at $ROOT/.venv" >&2
  echo "Run: cd \"$ROOT\" && ./install.sh" >&2
  exit 1
fi
exec "$PY" "$ROOT/ssh_gui.py" "$@"
